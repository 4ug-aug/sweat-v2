{
  "name": "gui",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#project/*": "../*"
  },
  "scripts": {
    "dev": "vite dev --port 3010",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "auth:generate": "bunx auth@latest generate --config src/lib/auth.ts --output src/lib/auth-schema.ts --adapter drizzle --dialect sqlite --yes",
    "db:generate": "bunx drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun run src/server/migrate.ts",
    "benchmark:room": "bun run benchmarks/room-load.ts",
    "benchmark:timeline": "bun run benchmarks/timeline-render.tsx",
    "seed:admin": "bun run src/server/seed-admin.ts",
    "coordinator": "bun --watch run src/server/server-main.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cursor/sdk": "^1.0.26",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@paper-design/shaders-react": "^0.0.78",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-websocket": "^2",
    "@tiptap/extension-mention": "^3.29.1",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/react": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@tiptap/suggestion": "^3.29.1",
    "better-auth": "^1.5.3",
    "better-sqlite3": "11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.24.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "16.28.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-config": "latest",
    "@tauri-apps/cli": "^2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
